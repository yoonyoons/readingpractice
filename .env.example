# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 값이 비어 있으면 데모 모드로 동작합니다 (샘플 기사 + 로컬 파일 DB).

# 로그인 쿠키 서명용 비밀값 (배포 시 필수, 32자 이상 무작위 문자열)
SESSION_SECRET=

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google AI Studio 에서 발급
GEMINI_API_KEY=
# 기본값: gemini-3.5-flash
GEMINI_MODEL=

# Supabase 프로젝트 설정 > API (secret key 또는 service_role key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 주간 초안 자동 준비(Vercel Cron) 호출 인증용 무작위 문자열 (배포 시 필수)
CRON_SECRET=

# (선택) 값을 넣으면 교사 회원가입 시 이 코드를 입력해야 합니다
TEACHER_SIGNUP_CODE=
