# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 값이 비어 있으면 데모 모드로 동작합니다 (예시 기사 + 로컬 파일 DB).

# 로그인 쿠키 서명용 비밀값 (배포 시 필수, 32자 이상 무작위 문자열)
SESSION_SECRET=

# Brave Search API 키 (api-dashboard.search.brave.com) - 지난 7일 뉴스 수집에 사용
BRAVE_API_KEY=

# Anthropic API 키 (platform.claude.com > API Keys) - 주제 선정, 기사·퀴즈 작성, 요약 채점에 사용
ANTHROPIC_API_KEY=
# 기본값: claude-opus-5
CLAUDE_MODEL=

# Supabase 프로젝트 설정 > API (secret key 또는 service_role key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 주간 초안 자동 준비(Vercel Cron) 호출 인증용 무작위 문자열 (배포 시 필수)
CRON_SECRET=

# 교사 가입 인증 코드 메일 발송용 SMTP (배포 시 필수. 없으면 개발 환경에서만 코드가 콘솔·화면에 표시됩니다)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=내 Gmail 주소, SMTP_PASS=Google 계정의 '앱 비밀번호'
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# (선택) 보내는 사람 표시. 비우면 SMTP_USER 로 보냅니다
MAIL_FROM=

# (선택) 교사 가입을 허용할 메일 도메인. 쉼표로 여러 개. 비우면 ".go.kr"로 끝나는 모든 교육청 메일 허용
# 예: TEACHER_EMAIL_DOMAINS=sen.go.kr,goe.go.kr
TEACHER_EMAIL_DOMAINS=

# (선택) 값을 넣으면 교사 회원가입 시 메일 인증에 더해 이 코드도 입력해야 합니다
TEACHER_SIGNUP_CODE=

# (선택) 1로 두면 API 키가 있어도 예시 기사·규칙 채점으로 동작합니다 (시연·자동 검사용, 비용 0)
FORCE_DEMO=
